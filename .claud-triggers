# Auto-Trigger Configuration

# This file configures automatic prompts for supporting materials.
# The AI agent reads this to determine when to auto-prompt.

[triggers]
enabled = true

# Trigger after lesson completion
lesson_complete = true
# Prompt for: pitfalls, rosetta, interview questions

# Trigger after exercise completion
exercise_complete = true
# Prompt for: bugs encountered, rosetta updates

# Trigger when marking module complete
module_complete = true
# Run full checklist, create all missing materials

# Trigger after completing same module in 2+ languages
cross_language_threshold = 2
# Update cross-language comparison vault note

[auto_create]
# Auto-create without asking (default: false, always prompt first)
pitfalls = false
rosetta = false
interview = false

# Set to true to auto-create everything without prompting
auto_all = false

[prompts]
# Prompt style: "verbose" or "concise"
style = "concise"

# Show checklist with checkboxes
use_checkboxes = true

# Suggest "yes to all" option
suggest_yes_all = true

[opt_out]
# User can disable auto-triggers for a session with:
# /no-auto
#
# Re-enable with:
# /auto
